# Copy this file to .env and fill in your values

# 1. Gemini API — get free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. HuggingFace token — get free at: https://huggingface.co/settings/tokens
#    Used for renovation concept image generation (Stable Diffusion XL)
#    Create account → Settings → Access Tokens → New Token (read permission is enough)
HF_TOKEN=your_huggingface_token_here
